{
 "title": "Central Kalimantan: district-days with no cloud-free look (cloud) for most of the district",
 "rule": "A district-day counts when more than half of the no-fire cell-days of the district on that day had no cloud-free look from Terra or Aqua, because of cloud: U / (T + U) > 0.5.",
 "threshold": 0.5,
 "definition": {
  "cell_day": "One 0.01 degree cell on one UTC day, classed from the MODIS FireMask of Terra and Aqua. T: no fire and at least one cloud-free look at the land. U: no fire and no cloud-free look, with cloud in at least one of the two masks. Cells with fire or with no data are in neither.",
  "district_day": "One of the 14 districts on one day. It counts (district_days_above) when U / (T + U) > 0.5: cloud left more than half of its no-fire cells with no cloud-free look.",
  "district_days": "All counted district-days: the number that the days with no cloud-free look (cloud) are out of. 0 district-days had no no-fire cell at all and are in neither number.",
  "days_counted": "Only days with a FireMask file of both Terra and Aqua for the whole box are counted, so each counted day had the same chances of a cloud-free look; a day with no cloud-free look for lack of a file is listed under days_left_out and is not counted.",
  "worst_day": "Per season, the single counted day with the highest share of no-fire cell-days with no cloud-free look (cloud), over all 14 districts together: U / (T + U) of that day, with the number of fire cells (F) of the same day.",
  "scope": "total, districts and seasons hold the Aug to Oct seasons only; the Jan to Mar 2023 quarter, with far more cloud and so far more days with no cloud-free look, is kept apart under wet_season_contrast."
 },
 "lower_bound_note": "Thick smoke is not flagged as cloud by the MODIS FireMask, so a day under thick smoke is not counted here: the count is a lower bound on days with no cloud-free look.",
 "excluded": {
  "season": "2019",
  "why": "The 2019 season is locked by a registered test of a sibling project: no count of days with no cloud-free look (cloud) was made for it and its file was not opened."
 },
