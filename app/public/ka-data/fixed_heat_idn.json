iles, as NASA wrote them.","publisher":"NASA LANCE / FIRMS","product":"FIRMS standard processing (SP) country archive","type_attribute":"0 = presumed vegetation fire, 1 = active volcano, 2 = other static land source, 3 = offshore. Types 1, 2 and 3 are counted; no confidence filter is applied to them.","url_pattern":"https://firms.modaps.eosdis.nasa.gov/data/country/{source}/{year}/{source}_{year}_Indonesia.csv","license":"NASA FIRMS open data (no restrictions; cite LANCE/FIRMS)","manifest":{"file":"data-raw/ss/data_manifest.json","sha256":"de7fff88ca8c969a483ed6985e78085b073b0fa33950fb2eb962657dadd80661","generated_utc":"2026-11-14T06:40:40+00:00"},"read_from":"data-raw/ss/raw/source=<sensor>/year=<year>/part.parquet (the downloaded CSV as parquet)","files":[{"sensor":"modis","year":2021,"rows":14210,"rows_type_1_2_3_in_box":2495,"version":["6.03"],"first_date":"2021-01-01","last_date":"2021-12-31","url":"https://firms.modaps.eosdis.nasa.gov/data/country/modis/2021/modis_2021_Indonesia.csv","downloaded_utc":"2026-11-14T06:30:00+00:00","csv_sha256":"62d0c407f9e9ebbecdddeae1529cc405e254e0aaa4a01f7a427929a186e3d0a0","parquet_sha256":"e9df2c9406b9e55c3c4b656ef0b44015243345e40128ad6425c6be85f5058854"},{"sensor":"modis","year":2022,"rows":11279,"rows_type_1_2_3_in_box":2398,"version":["6.03"],"first_date":"2022-01-03","last_date":"2022-12-31","url":"https://firms.modaps.eosdis.nasa.gov/data/country/modis/2022/modis_2022_Indonesia.csv","downloaded_utc":"2026-11-14T06:30:07+00:00","csv_sha256":"7ba203f76f72e96d73b03abb76a08613d59edb2c90fe17aaf580a18648f6fd33","parquet_sha256":"239f039c8d500068dbffec2c4aacb0dbee0429026d72f776e02ee453ea9d1e46"},{"sensor":"modis","year":2023,"rows":52156,"rows_type_1_2_3_in_box":4273,"version":["61.03"],"first_date":"2023-01-01","last_date":"2023-12-31","url":"https://firms.modaps.eosdis.nasa.gov/data/country/modis/2023/modis_2023_Indonesia.csv","downloaded_utc":"2026-11-14T06:30:18+00:00","csv_sha256":"9f9d79cc84eefab271fc82e63b7c49309547a1c3